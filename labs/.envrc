# direnv hook: applies lab-env.sh automatically to every lab directory under
# labs/, so there is nothing to remember to source. Run `direnv allow` once
# after cloning to approve it. Without direnv installed this file is inert, and
# `source labs/lab-env.sh` does the same job by hand.
#
# direnv runs .envrc with the working directory set to this file's directory.
source ./lab-env.sh
