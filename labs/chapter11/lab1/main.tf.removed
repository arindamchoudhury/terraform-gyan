# Chapter 11 Lab, Part A, step 2 — the same configuration with the guarded
# resource deleted. prevent_destroy is not recorded in state, so deleting the
# block deletes the guard, and the next apply destroys the bucket.

terraform {
  required_version = ">= 1.15"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}
