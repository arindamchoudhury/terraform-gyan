# Canaries, not credentials. Fake, unique strings whose only job is to be
# searched for afterwards. AKIALEAKCANARY01 has the shape of a real AWS access
# key ID (AKIA prefix, 20 characters), so ordinary secret scanners react to it
# the way they would to the real thing; the secret carries a random suffix so it
# cannot collide with anything else in the repository.
#
# Never put real credentials in a file like this. That is the whole point of the
# experiment: the values do not stay here.

bucket = "tf-state-lab"
key    = "leak/terraform.tfstate"
region = "us-east-1"

access_key = "AKIALEAKCANARY01"
secret_key = "s3cr3t-canary-value-9f2a"

# --- emulator-only below this line --------------------------------------
endpoints                   = { s3 = "http://localhost:4566" }
use_path_style              = true
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_requesting_account_id  = true
