# The control for the experiment: the same backend, with the two credential
# arguments removed. Terraform picks the credentials up from AWS_ACCESS_KEY_ID
# and AWS_SECRET_ACCESS_KEY instead, and neither .terraform/terraform.tfstate
# nor the saved plan ends up carrying them.
#
#   terraform init -reconfigure -backend-config=config.env.tfbackend

bucket = "tf-state-lab"
key    = "leak/terraform.tfstate"
region = "us-east-1"

# --- emulator-only below this line --------------------------------------
endpoints                   = { s3 = "http://localhost:4566" }
use_path_style              = true
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_requesting_account_id  = true
